# // ATENÇÃO: Configure suas credenciais de e-mail em um arquivo .env
# // Exemplo para Gmail:
# // EMAIL_USER=seu-email@gmail.com
# // EMAIL_PASS=sua-senha-de-aplicativo
# // Para gerar uma senha de aplicativo no Gmail, ative a verificação em duas etapas
# // e depois vá em "Senhas de app" na sua conta Google.

EMAIL_USER=seu-email@gmail.com
EMAIL_PASS=sua-senha-de-aplicativo